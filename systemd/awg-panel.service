[Unit]
Description=AmneziaWG web panel
After=network-online.target awg-quick@awg0.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/awg-panel
EnvironmentFile=-/etc/awg-panel/panel.env
ExecStart=/opt/awg-panel/venv/bin/gunicorn --workers 1 --threads 4 \
  --bind ${PANEL_BIND} --certfile /etc/awg-panel/tls.crt --keyfile /etc/awg-panel/tls.key app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
